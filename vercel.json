{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 3 * * *" },
    { "path": "/api/cron/retry-prices", "schedule": "0 9 * * *" }
  ],
  "functions": {
    "api/cron/daily.ts": { "memory": 1536, "maxDuration": 60 },
    "api/cron/retry-prices.ts": { "memory": 1536, "maxDuration": 60 },
    "api/analyze.ts": { "memory": 1536, "maxDuration": 60 }
  }
}
